# 环境变量配置
# 复制此文件为 .env 并修改：  cp .env.example .env
#
# ⚠️ 从 v1.1 起，SECRET_KEY 与 ADMIN_PASSWORD 为**必填**：
#    缺失或仍在用下面的示例值时，应用会**拒绝启动**并打印修复提示。
#    这是故意的 —— 旧版本为这两个值提供了写死在源码里的兜底值，而仓库是公开的，
#    等于公开了默认管理员口令与 JWT 签名密钥（任何人可伪造管理员令牌）。
#    生成随机值：
#       python -c "import secrets; print(secrets.token_urlsafe(48))"

# JWT 密钥（必填，至少 32 字符，务必使用随机值）
SECRET_KEY=

# 管理员初始账号（ADMIN_PASSWORD 必填，至少 8 字符）
ADMIN_EMAIL=admin@xjtlu.edu.cn
ADMIN_PASSWORD=

# 数据库
DATABASE_URL=sqlite:///./int305_arena.db

# 文件存储
UPLOAD_DIR=./data/uploads
DATASET_DIR=./data/datasets
# 标准答案单独存放，不在任何可下载目录下（无下载端点）
ANSWERS_DIR=./data/answers
MAX_UPLOAD_SIZE_MB=50

# 服务器
API_HOST=0.0.0.0
API_PORT=8000

# 学生注册是否需要审核
REQUIRE_APPROVAL=false

# CORS 允许的前端域名（逗号分隔可追加多个）
FRONTEND_URL=http://localhost:8080
# CORS_ORIGINS=http://localhost,https://your-domain.edu.cn

# 仅在自动化测试/一次性本地演示时设为 1，可绕过上面的凭据校验（启动时会打印醒目告警）
# ALLOW_INSECURE_DEFAULTS=1
